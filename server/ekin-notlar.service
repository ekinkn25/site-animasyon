[Unit]
Description=Ekin'in defteri (not API'si)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/ekin-site/server
ExecStart=/usr/bin/python3 /opt/ekin-site/server/notlar.py
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1
# Güvenlik sıkılaştırma
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/ekin-notlar

[Install]
WantedBy=multi-user.target
