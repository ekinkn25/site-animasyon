# Bu dosyayı .env adıyla kopyala ve doldur:  cp .env.example .env
# .env dosyası şifre içerir, asla paylaşma / git'e ekleme.

# API'nin dinleyeceği adres (nginx aynı makinede olduğu için 127.0.0.1 yeterli)
HOST=127.0.0.1
PORT=8787

# Notların tutulacağı SQLite dosyası
DB_PATH=/var/lib/ekin-notlar/notlar.db

# --- Mail bildirimi (Gmail örneği) ---
# Gmail'de 2 adımlı doğrulama açıkken https://myaccount.google.com/apppasswords
# adresinden bir "uygulama şifresi" oluştur ve SMTP_PASS'e yaz (normal şifren DEĞİL).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=karincaliekin@gmail.com
SMTP_PASS=buraya-16-haneli-uygulama-sifresi
MAIL_TO=karincaliekin@gmail.com
MAIL_FROM=karincaliekin@gmail.com

# Notları tarayıcıdan/curl ile listelemek için uzun, rastgele bir anahtar
# (boş bırakırsan GET /api/notes kapalı olur). Üretmek için: openssl rand -hex 24
ADMIN_TOKEN=

# Site ile API farklı alan adlarındaysa sitenin adresi (virgülle birden fazla)
# Aynı alan adındaysa (nginx /api yönlendirmesi) boş bırak.
ALLOWED_ORIGINS=

# Spam koruması: bir IP 10 dakikada en fazla 3 not, günde toplam en fazla 300 not
RATE_PER_IP=3
RATE_WINDOW_SEC=600
RATE_DAILY=300

# IP adresleri açık tutulmaz, bu tuzla karıştırılıp kısaltılmış hali saklanır
IP_SALT=bunu-rastgele-bir-seyle-degistir
